# Copy to deploy/.env on the Russian host. Never commit actual values.
CRM_DOMAIN=crm.example.ru
TLS_EMAIL=admin@example.ru
APP_ORIGIN=https://crm.example.ru
# Generate a new secret on the selected Russian host; do not reuse Google secrets.
APP_SECRET=GENERATE_A_NEW_RANDOM_SECRET_ON_THE_RUSSIAN_HOST
# Use private DB endpoint and the provider CA/TLS settings required by db.mjs.
DATABASE_URL=postgresql://runtime_user:REPLACE_PASSWORD@PRIVATE_DB_HOST:5432/fiverox
DATABASE_CA_FILE=/run/postgres-ca.crt
POSTGRES_CA_PATH=/opt/fiverox/secrets/postgres-ca.crt
SMTP_HOST=REPLACE_RUSSIAN_MAIL_PROVIDER
SMTP_PORT=465
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASS=REPLACE_SMTP_PASSWORD
MAIL_FROM=FIVEROX CRM <crm@example.ru>
