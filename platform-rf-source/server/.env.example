NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_ORIGIN=https://crm.example.ru
APP_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_ENGINE=pg
# Restricted runtime account; do not include sslmode query parameters.
DATABASE_URL=postgresql://fiverox_runtime:CHANGE_ME@PRIVATE_DB_HOST:5432/fiverox
# Migration owner is used ONLY for migrate/bootstrap, never in the server process.
MIGRATION_DATABASE_URL=postgresql://migration_owner:CHANGE_ME@PRIVATE_DB_HOST:5432/fiverox
# Required for a cloud private CA; server uses verified TLS in production.
DATABASE_CA_FILE=/run/secrets/postgresql-ca.pem
SMTP_HOST=SMTP_HOST_IN_APPROVED_RF_CONFIGURATION
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
MAIL_FROM=FIVEROX <crm@example.ru>
PUBLIC_DIR=/app/site
